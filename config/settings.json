{
    "window": {
        "title": "Virtual Piano Hands",
        "width": 1280,
        "height": 720,
        "fps": 60,
        "fullscreen": false
    },

    "camera": {
        "index": 0,
        "mirror": true
    },

    "keyboard": {
        "radius": 180,
        "gap": 250,
        "keys": 12
    },

